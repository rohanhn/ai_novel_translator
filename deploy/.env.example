# /opt/novel-translator/.env — chép từ file này rồi `chmod 600 .env`. Mọi bí mật chỉ nằm ở đây.
# Giá trị có ký tự `$` (hash argon2) phải đặt trong dấu nháy đơn.

# ---------------------------------------------------------------- image (bắt buộc IMAGE_TAG)
# Tag phát hành do CI đẩy lên GHCR. Cập nhật/rollback: đổi dòng này rồi
# `docker compose pull && docker compose up -d`.
IMAGE_TAG=v0.2.0
# Repo image trên GHCR, viết thường (đổi khi fork/đổi tên repo).
# IMAGE_REPO=ghcr.io/rohanhn/ai_novel_translator

# ---------------------------------------------------------------- định tuyến qua Traefik
# Tên miền của app (bắt buộc). DNS phải trỏ về VPS.
APP_HOST=truyen.example.com
# Tên project compose + tên router/service Traefik; đổi khi chạy hai bản trên cùng VPS.
# APP_NAME=novel-translator
# Tên entrypoint HTTPS và certresolver Let's Encrypt khai báo trong Traefik.
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
# Tên hai Docker network ngoài do hạ tầng tạo.
# TRAEFIK_NETWORK=traefik
# POSTGRES_NETWORK=postgres

# ---------------------------------------------------------------- app (bắt buộc)
# Role + database riêng của app trên Postgres dùng chung; host là tên/alias của container
# Postgres trên network `postgres`. URL-encode mật khẩu nếu có ký tự @ : / ? # %.
NT_DATABASE_URL=postgresql://ai_novel_translator:<mat-khau-db>@postgres:5432/ai_novel_translator
# Hash argon2 của mật khẩu đăng nhập web, tạo bằng:
#   docker run --rm -it ghcr.io/rohanhn/ai_novel_translator:<tag> novel hash-password
NT_PASSWORD_HASH=''
# Key Gemini (https://aistudio.google.com/apikey). Một key cho mỗi provider.
GEMINI_API_KEY=
# IP của Traefik trên network `traefik` (khuyến nghị: gán IP tĩnh cho Traefik). Nếu không gán
# được thì dùng subnet của network đó (vd. 172.18.0.0/16), chấp nhận rằng mọi container khác
# trên network này cũng được tin. Xem docs/DEPLOY.md.
NT_TRUSTED_PROXY=

# ---------------------------------------------------------------- app (tuỳ chọn)
# NT_CHAIN=gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite
# NT_GEMINI_TIMEOUT=120
# NT_DB_POOL_MAX=5
# NT_CHAPTER_CHAR_LIMIT=20000
# Không đặt NT_PROVIDER/NT_MODEL trên server (bỏ qua chuỗi model, chỉ dùng cho dev).

# ---------------------------------------------------------------- sao lưu (deploy/backup.sh)
# Public key age (age1...), nhiều key cách nhau bằng dấu phẩy. Private key giữ NGOÀI VPS.
BACKUP_AGE_RECIPIENT=
# Thư mục chứa bản sao lưu (mode 700, cùng chủ với .env). Giữ 14 bản mới nhất.
# BACKUP_DIR=/var/backups/novel-translator
# Image chứa pg_dump, cùng major version với server Postgres.
# BACKUP_PG_IMAGE=postgres:16
