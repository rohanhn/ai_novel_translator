# Provider mặc định: anthropic | openai | ollama | echo
NT_PROVIDER=anthropic
# Model mặc định (để trống = dùng mặc định của provider)
NT_MODEL=

# PostgreSQL (database + role riêng trên instance dùng chung, tạo thủ công một lần)
# Dev ngoài Docker: localhost; trong Docker: hostname của container Postgres (vd. shared-postgres)
NT_DATABASE_URL=postgresql://ai_novel_translator:<password>@localhost:5432/ai_novel_translator
# Database riêng cho pytest (bị TRUNCATE sau mỗi test, KHÔNG trỏ vào database thật)
NT_TEST_DATABASE_URL=postgresql://ai_novel_translator:<password>@localhost:5432/ai_novel_translator_test
# Số kết nối tối đa của pool
NT_DB_POOL_MAX=5

# Kích thước tối đa (ký tự) của một đoạn gửi cho LLM
NT_MAX_SEGMENT_CHARS=3000

# Credentials cho từng provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Base URL cho provider tương thích OpenAI (Ollama, vLLM, DeepSeek...)
NT_OPENAI_BASE_URL=
NT_OLLAMA_BASE_URL=http://localhost:11434/v1
