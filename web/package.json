{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:contrast": "node scripts/check-contrast.mjs",
		"check:offline": "node scripts/check-offline.mjs",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource/be-vietnam-pro": "^5.3.0",
		"@fontsource/cormorant-garamond": "^5.3.0",
		"@fontsource/ma-shan-zheng": "^5.3.1",
		"@fontsource/noto-serif": "^5.3.0",
		"@fontsource/noto-serif-sc": "^5.3.1"
	}
